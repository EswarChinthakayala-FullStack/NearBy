# --- API ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=15000

# --- Map tiles (OpenStreetMap, no key required) ---
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=© OpenStreetMap contributors
VITE_MAP_PROVIDER=carto
VITE_MAP_TILE_STYLE_DARK=https://a.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}@2x.png
VITE_MAP_TILE_STYLE_LIGHT=https://a.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}@2x.png

# --- App ---
VITE_APP_NAME=Local Tourism Guide
VITE_APP_ENV=development
VITE_DEFAULT_MAP_CENTER_LAT=17.6868
VITE_DEFAULT_MAP_CENTER_LNG=83.2185
VITE_MAP_DEFAULT_CENTER_LAT=15.4989
VITE_MAP_DEFAULT_CENTER_LNG=73.8278
VITE_MAP_DEFAULT_ZOOM=13

# --- Feature Flags ---
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_FEATURE_AI_SEARCH=true
VITE_FEATURE_ITINERARY_GENERATOR=true
VITE_FEATURE_OFFLINE_RADAR=true
