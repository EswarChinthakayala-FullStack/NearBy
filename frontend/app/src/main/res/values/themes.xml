<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Emerald SaaS Application DayNight Theme (Light/Dark Mode) -->
    <style name="Theme.Nearby" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/emerald_500</item>
        <item name="colorPrimaryDark">@color/emerald_700</item>
        <item name="colorAccent">@color/emerald_400</item>

        <!-- Window & Background -->
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/bg_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/bg_primary</item>

        <!-- Disable default Material elevation and action bars -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom Bottom Drawer Dialog Theme -->
    <style name="Theme.Nearby.Dialog" parent="Theme.MaterialComponents.DayNight.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>