<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP PLACE COVER IMAGE & DETAILS HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/ivPlaceCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_grid_pattern" />

            <!-- DARK GRADIENT OVERLAY FOR READABILITY -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bottom_scrim" />

            <!-- CATEGORY BADGE -->
            <TextView
                android:id="@+id/tvCategoryBadge"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_emerald_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/emerald_400"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Temple" />

            <!-- PLACE RATING BADGE -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_skip_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/amber_400" />

                <TextView
                    android:id="@+id/tvPlaceRating"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="4.8" />
            </LinearLayout>

            <!-- PLACE TITLE & LOCATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvPlaceName"
                    style="@style/Typography.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Birla Temple" />

                <TextView
                    android:id="@+id/tvPlaceLocation"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    tools:text="Hyderabad, Telangana" />
            </LinearLayout>
        </RelativeLayout>

        <!-- CARD BODY CONTAINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- RATING STARS & TIMESTAMP HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- 5 STAR RATING ROW -->
                <LinearLayout
                    android:id="@+id/layoutStarRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/star1"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/amber_400" />

                    <ImageView
                        android:id="@+id/star2"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/amber_400" />

                    <ImageView
                        android:id="@+id/star3"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/amber_400" />

                    <ImageView
                        android:id="@+id/star4"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/amber_400" />

                    <ImageView
                        android:id="@+id/star5"
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="2dp"
                        android:src="@drawable/ic_star"
                        app:tint="@color/amber_400" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReviewTimestamp"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    tools:text="Reviewed 2 days ago" />
            </RelativeLayout>

            <!-- REVIEW HEADLINE TITLE -->
            <TextView
                android:id="@+id/tvReviewTitle"
                style="@style/Typography.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Breathtaking sunset view &amp; peaceful atmosphere!" />

            <!-- REVIEW COMMENT TEXT -->
            <TextView
                android:id="@+id/tvReviewComment"
                style="@style/Typography.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:lineSpacingExtra="3dp"
                android:maxLines="3"
                android:textColor="@color/text_secondary"
                android:textSize="13.5sp"
                tools:text="The architecture is pure white marble and looks stunning during evening hours. Very quiet and serene experience..." />

            <!-- READ MORE / READ LESS EXPAND TOGGLE -->
            <TextView
                android:id="@+id/btnReadMore"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Read More"
                android:textColor="@color/emerald_400"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- HORIZONTAL GALLERY FOR ATTACHED PHOTOS -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvReviewPhotos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- HELPFUL VOTES BADGE -->
            <TextView
                android:id="@+id/tvHelpfulCount"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_skip_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/emerald_400"
                android:textSize="11.5sp"
                tools:text="18 people found this helpful" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_color" />

            <!-- ACTION BUTTONS FOOTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnViewPlace"
                    style="@style/Typography.Button"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.2"
                    android:background="@drawable/bg_emerald_badge"
                    android:gravity="center"
                    android:text="View Place"
                    android:textColor="@color/emerald_400"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnEditReview"
                    style="@style/Typography.Button"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center"
                    android:text="Edit"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp" />

                <ImageView
                    android:id="@+id/btnDeleteReview"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_glass_panel"
                    android:contentDescription="Delete Review"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/red_400" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
