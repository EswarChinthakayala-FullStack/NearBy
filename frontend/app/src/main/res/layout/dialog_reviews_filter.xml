<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- SORT BY SECTION -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT BY"
        android:textColor="@color/emerald_400"
        android:textSize="11sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgReviewSortBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbSortNewest"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:checked="true"
            android:text="Newest First"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSortOldest"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Oldest First"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSortHighestRating"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Highest Rating (5★ → 1★)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSortLowestRating"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Lowest Rating (1★ → 5★)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- WITH PHOTOS FILTER ROW -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <TextView
            style="@style/Typography.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="With Photos Only"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchWithPhotos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:thumbTint="@color/emerald_400"
            app:trackTint="@color/emerald_800" />
    </RelativeLayout>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnResetReviewFilters"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center"
            android:text="Reset"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnApplyReviewFilters"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_emerald_badge"
            android:gravity="center"
            android:text="Apply Filters"
            android:textColor="@color/emerald_400"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
