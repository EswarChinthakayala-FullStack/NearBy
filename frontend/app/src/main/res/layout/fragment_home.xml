<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- EXECUTIVE HEADER TOOLBAR -->
    <LinearLayout
        android:id="@+id/layoutHomeHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_500"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="@color/emerald_500">
        
        <!-- USER AVATAR CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardHomeUserAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/emerald_500"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/ivHomeUserAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHomeUserInitial"
                style="@style/Typography.Title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="@color/emerald_500"
                android:background="@color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="A" />
        </androidx.cardview.widget.CardView>

        <!-- GREETING & NAME -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvHomeGreeting"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Good Afternoon," />

            <TextView
                android:id="@+id/tvHomeUserName"
                style="@style/Typography.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Alex Morgan" />
        </LinearLayout>

        <!-- LOCATION BADGE & NOTIFICATION BTN -->
        <LinearLayout
            android:id="@+id/layoutHeaderRight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnHomeLocation"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_secondary"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:textColor="@color/emerald_500"
                android:textSize="11.5sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:maxWidth="140dp"
                tools:text="📍 Hyderabad, TS" />

            <ImageView
                android:id="@+id/btnHomeNotification"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_button_secondary"
                android:padding="8dp"
                android:src="@drawable/ic_notification"
                app:tint="@color/emerald_500" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/homeScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="96dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- SEARCH BAR CARD -->
            <RelativeLayout
                android:id="@+id/cardHomeSearch"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_glass_panel"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_search"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Typography.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="10dp"
                    android:layout_toEndOf="@id/ivSearchIcon"
                    android:text="Search places, attractions, cities..."
                    android:textColor="@color/text_muted"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/btnHomeAiAssist"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_button_primary"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="✨ AI Search"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- CATEGORIES HORIZONTAL RECYCLER -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCategories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/bg_category_chip_normal" />

            <!-- TRAVEL INSPIRATION BANNER -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardHomeBanner"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivBannerImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/bg_dark_gradient" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_gradient_overlay" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tvBannerTitle"
                            style="@style/Typography.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Explore Waterfalls &amp; Nature Treasures" />

                        <TextView
                            android:id="@+id/tvBannerSubtitle"
                            style="@style/Typography.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/zinc_300"
                            android:textSize="12sp"
                            tools:text="Discover top scenic waterfalls and green valleys recommended by AI" />
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- SECTION 1: TRENDING DESTINATIONS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/Typography.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Trending Destinations"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeAllTrending"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="See All →"
                    android:textColor="@color/emerald_400"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvTrending"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- SECTION 2: NEARBY ATTRACTIONS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/Typography.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nearby Attractions"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeAllNearby"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="See All →"
                    android:textColor="@color/emerald_400"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNearby"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- SECTION 3: RECOMMENDED FOR YOU -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/Typography.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recommended For You"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeAllRecommended"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="See All →"
                    android:textColor="@color/emerald_400"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecommended"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            <!-- SECTION 4: POPULAR DESTINATIONS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="24dp">

                <TextView
                    style="@style/Typography.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Popular Destinations"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnSeeAllPopular"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="See All →"
                    android:textColor="@color/emerald_400"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvPopular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- LOCATION PERMISSION OVERLAY -->
    <RelativeLayout
        android:id="@+id/layoutLocationPermission"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_primary"
        android:elevation="10dp"
        android:padding="32dp"
        android:visibility="gone">
        
        <ImageView
            android:id="@+id/ivLocationGraphic"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="80dp"
            android:src="@drawable/ic_location"
            app:tint="@color/emerald_500"/>
            
        <TextView
            android:id="@+id/tvLocationPermissionTitle"
            style="@style/Typography.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivLocationGraphic"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="Discover What's Nearby"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />
            
        <TextView
            android:id="@+id/tvLocationPermissionDesc"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvLocationPermissionTitle"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="We use your location to discover nearby attractions, personalized recommendations, weather-aware suggestions, and AI travel planning."
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />
            
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="48dp"
            android:orientation="vertical">
            
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAllowLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_button_primary"
                android:text="Allow Location"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />
                
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnNotNowLocation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:text="Not Now"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
