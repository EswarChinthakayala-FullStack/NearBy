<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/route_panel_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_16"
    android:background="@drawable/bg_glass_panel"
    android:elevation="@dimen/shadow_large"
    android:orientation="horizontal"
    android:padding="@dimen/space_12">

    <!-- LEFT: Vertical dot connector (From dot → line → To dot) -->
    <LinearLayout
        android:layout_width="24dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingVertical="@dimen/space_12">

        <!-- From dot (Emerald filled circle) -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_button_primary" />

        <!-- Connecting dashed line -->
        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginVertical="4dp"
            android:background="@color/emerald_500" />

        <!-- To dot (Red destination pin) -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/bg_button_primary" />
    </LinearLayout>

    <!-- CENTER: From & To text input fields -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/space_8"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- FROM LOCATION INPUT -->
        <EditText
            android:id="@+id/et_from_location"
            style="@style/Typography.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="Current Location"
            android:inputType="text"
            android:maxLines="1"
            android:text="Current Location"
            android:textColor="@color/emerald_500"
            android:textColorHint="@color/text_muted" />

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/card_border" />

        <!-- TO DESTINATION INPUT -->
        <EditText
            android:id="@+id/et_to_destination"
            style="@style/Typography.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:gravity="center_vertical"
            android:hint="Search destination..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted" />

    </LinearLayout>

    <!-- RIGHT: Swap + Voice action column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Swap Locations Action Button -->
        <ImageButton
            android:id="@+id/btn_swap_locations"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_ghost"
            android:contentDescription="Swap Locations"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_swap" />

        <View
            android:layout_width="1dp"
            android:layout_height="@dimen/space_8" />

        <!-- Voice Search Icon -->
        <ImageButton
            android:id="@+id/btn_voice_route"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voice Search"
            android:padding="8dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_voice" />
    </LinearLayout>

</LinearLayout>
