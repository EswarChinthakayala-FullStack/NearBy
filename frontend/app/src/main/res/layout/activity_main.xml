<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- TOP STATUS BAR EMERALD BACKDROP -->
    <View
        android:id="@+id/view_status_bar_backdrop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_emerald_gradient"
        android:elevation="12dp" />

    <!-- FRAGMENT CONTAINER (NAV HOST) -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

    <!-- TOP OFFLINE BANNER -->
    <LinearLayout
        android:id="@+id/layout_offline_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#E11D48"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/space_8"
        android:visibility="gone">

        <TextView
            style="@style/Typography.BodySmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📡 No internet connection. Operating offline."
            android:textColor="@color/white" />
    </LinearLayout>

    <!-- BOTTOM NAVIGATION FADE SCRIM -->
    <View
        android:id="@+id/view_bottom_scrim"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_nav_scrim"
        android:clickable="false"
        android:focusable="false" />

    <!-- CUSTOM FLOATING GLASS BOTTOM NAVIGATION DOCK -->
    <include
        android:id="@+id/inc_main_bottom_nav"
        layout="@layout/view_main_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginBottom="16dp" />

</FrameLayout>
