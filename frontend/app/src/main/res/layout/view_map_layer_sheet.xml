<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_layer_sheet_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_glass_panel"
    android:elevation="@dimen/shadow_large"
    android:orientation="vertical"
    android:padding="@dimen/space_20"
    android:visibility="gone">

    <TextView
        style="@style/Typography.HeadlineSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Map Type &amp; Layers"
        android:textColor="@color/text_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:orientation="horizontal">

        <!-- Standard Layer Chip -->
        <Button
            android:id="@+id/chip_layer_standard"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Standard"
            android:textColor="@color/text_primary" />

        <!-- Night Layer Chip -->
        <Button
            android:id="@+id/chip_layer_night"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Dark Night"
            android:textColor="@color/text_primary" />

        <!-- Satellite Layer Chip -->
        <Button
            android:id="@+id/chip_layer_satellite"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_secondary"
            android:text="Satellite"
            android:textColor="@color/text_primary" />

    </LinearLayout>

</LinearLayout>
