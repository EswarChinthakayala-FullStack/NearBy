<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- TOP DESTINATION COVER IMAGE HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="160dp">

            <ImageView
                android:id="@+id/ivTripCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/bg_grid_pattern" />

            <!-- GRADIENT OVERLAY FOR READABILITY -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_bottom_scrim" />

            <!-- THEME BADGE -->
            <TextView
                android:id="@+id/tvTripThemeBadge"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_emerald_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/emerald_400"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Heritage &amp; Culture" />

            <!-- TRIP STATUS BADGE -->
            <TextView
                android:id="@+id/tvTripStatusBadge"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_skip_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/emerald_400"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Completed" />

            <!-- TITLE & DESTINATION OVERLAY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTripTitle"
                    style="@style/Typography.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="2-Day Heritage Exploration" />

                <TextView
                    android:id="@+id/tvTripDestination"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/zinc_300"
                    android:textSize="12.5sp"
                    tools:text="📍 Delhi, India • 2 Days" />
            </LinearLayout>
        </RelativeLayout>

        <!-- CARD CONTENT BODY -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- PROMPT PREVIEW CONTAINER -->
            <TextView
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YOUR AI REQUEST"
                android:textColor="@color/text_muted"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTripPromptPreview"
                style="@style/Typography.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Plan a 2-day family trip covering historical monuments, forts, and famous local street food markets in Delhi." />

            <TextView
                android:id="@+id/btnReadMorePrompt"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Read More"
                android:textColor="@color/emerald_400"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- STATS BADGES ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvBadgeDays"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    tools:text="⏱ 2 Days" />

                <TextView
                    android:id="@+id/tvBadgePlaces"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    tools:text="📍 8 Places" />

                <TextView
                    android:id="@+id/tvBadgeDistance"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    tools:text="🚗 34.5 KM" />

                <TextView
                    android:id="@+id/tvBadgeWeather"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_panel"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/amber_400"
                    android:textSize="11.5sp"
                    tools:text="☀ 26°C" />
            </LinearLayout>

            <!-- DIVIDER LINE -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_color" />

            <!-- FOOTER ROW: CREATED DATE & ACTION BUTTONS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTripCreatedDate"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    tools:text="Created 3 days ago" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnShareTrip"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_glass_panel"
                        android:contentDescription="Share Trip"
                        android:padding="8dp"
                        android:src="@drawable/ic_check"
                        app:tint="@color/text_primary" />

                    <ImageView
                        android:id="@+id/btnDeleteTrip"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_glass_panel"
                        android:contentDescription="Delete Trip"
                        android:padding="8dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/red_400" />

                    <TextView
                        android:id="@+id/btnOpenTrip"
                        style="@style/Typography.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_emerald_badge"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Open Trip  →"
                        android:textColor="@color/emerald_400"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </RelativeLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
