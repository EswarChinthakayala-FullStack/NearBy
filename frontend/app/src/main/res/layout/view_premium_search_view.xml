<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/searchContainer"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="@drawable/bg_glass_panel"
    android:elevation="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16">

    <ImageView
        android:id="@+id/ivSearchIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Search Icon"
        android:src="@drawable/ic_search"
        app:tint="@color/emerald_400" />

    <EditText
        android:id="@+id/etQuery"
        style="@style/Typography.BodyMedium"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:background="@null"
        android:hint="Search places, cities, categories..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted" />

    <ImageButton
        android:id="@+id/btnClear"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@null"
        android:contentDescription="Clear Text"
        android:src="@drawable/ic_close"
        android:visibility="gone"
        app:tint="@color/text_muted" />

    <ImageButton
        android:id="@+id/btnVoice"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:background="@null"
        android:contentDescription="Voice Search"
        android:src="@drawable/ic_voice"
        app:tint="@color/emerald_400" />

    <ImageButton
        android:id="@+id/btnFilter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_filter_icon_zinc"
        android:contentDescription="Filter"
        android:padding="8dp"
        android:src="@drawable/ic_filter"
        app:tint="@color/emerald_400" />
</LinearLayout>
