<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- SUBTLE EMERALD GRID PATTERN -->
    <com.example.nearby.designsystem.GridBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingVertical="@dimen/space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- APP BRANDING HEADER -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="App Logo"
                android:src="@drawable/ic_app_logo" />

            <TextView
                style="@style/Typography.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_12"
                android:text="Welcome Back"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Typography.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Sign in to access your personal travel guide"
                android:textColor="@color/text_secondary" />

            <!-- EMAIL FIELD CONTAINER -->
            <TextView
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_24"
                android:text="EMAIL ADDRESS"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Email Icon"
                    android:src="@drawable/ic_profile" />

                <EditText
                    android:id="@+id/et_login_email"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="alex.rivera@example.com"
                    android:inputType="textEmailAddress"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />
            </LinearLayout>

            <!-- PASSWORD FIELD CONTAINER -->
            <TextView
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_16"
                android:text="PASSWORD"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_glass_panel"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/space_16">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Lock Icon"
                    android:src="@drawable/ic_check" />

                <EditText
                    android:id="@+id/et_login_password"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/space_12"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="••••••••"
                    android:inputType="textPassword"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary" />

                <ImageButton
                    android:id="@+id/btn_toggle_password"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Toggle Password Visibility"
                    android:src="@drawable/ic_eye_off" />
            </LinearLayout>

            <!-- REMEMBER ME & FORGOT PASSWORD ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/cb_remember_me"
                    style="@style/Typography.BodySmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Remember me"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_forgot_password"
                    style="@style/Typography.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="Forgot password?"
                    android:textColor="@color/emerald_500" />
            </LinearLayout>

            <!-- ERROR TEXT -->
            <TextView
                android:id="@+id/tv_login_error"
                style="@style/Typography.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/status_danger"
                android:visibility="gone" />

            <!-- SUBMIT LOGIN BUTTON -->
            <Button
                android:id="@+id/btn_login_submit"
                style="@style/Typography.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_20"
                android:background="@drawable/bg_button_primary"
                android:text="Sign In  →"
                android:textColor="@color/white" />

            <!-- REGISTER LINK -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <TextView
                    style="@style/Typography.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account?"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_link_register"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="Sign Up"
                    android:textColor="@color/emerald_500" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
