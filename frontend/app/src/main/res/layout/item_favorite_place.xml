<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/space_16"
    android:layout_marginBottom="@dimen/space_16"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- COVER IMAGE WITH CATEGORY BADGE & FAVORITE HEART BADGE -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/ivCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Place Image"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_wave_top" />

            <!-- CATEGORY BADGE -->
            <TextView
                android:id="@+id/tvCategoryBadge"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_glass_panel"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:textColor="@color/emerald_400"
                tools:text="#HISTORICAL" />

            <!-- FAVORITE HEART BUTTON -->
            <ImageButton
                android:id="@+id/btnFavoriteToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_glass_panel"
                android:contentDescription="Remove Favorite"
                android:padding="8dp"
                android:src="@drawable/ic_heart_filled"
                app:tint="@color/status_danger" />

            <!-- OPEN/CLOSED STATUS BADGE -->
            <TextView
                android:id="@+id/tvStatusBadge"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_margin="12dp"
                android:background="@drawable/bg_skip_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Open Now"
                android:textColor="@color/emerald_400" />
        </RelativeLayout>

        <!-- CARD DETAILS CONTENT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_16">

            <!-- TITLE & RATING ROW -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvPlaceName"
                    style="@style/Typography.HeadlineMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/layoutRating"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    tools:text="Lotus Temple" />

                <LinearLayout
                    android:id="@+id/layoutRating"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvRating"
                        style="@style/Typography.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/emerald_400"
                        tools:text="★ 4.8" />

                    <TextView
                        android:id="@+id/tvReviewCount"
                        style="@style/Typography.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:textColor="@color/text_secondary"
                        tools:text="(1.2k)" />
                </LinearLayout>
            </RelativeLayout>

            <!-- LOCATION CITY & ADDRESS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_location"
                    app:tint="@color/text_muted" />

                <TextView
                    android:id="@+id/tvLocation"
                    style="@style/Typography.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/text_secondary"
                    tools:text="Kalkaji, New Delhi, India" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_color" />

            <!-- QUICK ACTIONS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNavigate"
                    style="@style/Typography.Button"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary"
                    android:text="Get Directions 🗺️"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/btnShare"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_panel"
                    android:contentDescription="Share"
                    android:padding="8dp"
                    android:src="@drawable/ic_share"
                    app:tint="@color/emerald_400" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
