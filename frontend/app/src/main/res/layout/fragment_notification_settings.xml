<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- TOOLBAR -->
    <com.example.nearby.designsystem.EmeraldToolbar
        android:id="@+id/notificationsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Typography.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notification Preferences"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Typography.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:text="Control push alerts, trip reminders, and attraction recommendations."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <com.example.nearby.presentation.profile.settings.widgets.SettingSwitchView
                android:id="@+id/switchTripReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.nearby.presentation.profile.settings.widgets.SettingSwitchView
                android:id="@+id/switchNearbyRecs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.nearby.presentation.profile.settings.widgets.SettingSwitchView
                android:id="@+id/switchReviewReplies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.example.nearby.presentation.profile.settings.widgets.SettingSwitchView
                android:id="@+id/switchTravelTips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
