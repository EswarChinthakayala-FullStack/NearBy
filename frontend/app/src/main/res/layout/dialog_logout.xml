<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_solid_drawer_panel"
    android:elevation="@dimen/shadow_large"
    android:orientation="vertical"
    android:padding="@dimen/space_24">

    <TextView
        style="@style/Typography.HeadlineMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Sign Out"
        android:textColor="@color/text_primary" />

    <TextView
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:text="Are you sure you want to sign out of your account? Your saved places will remain synced."
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_cancel_logout"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_neutral_pill"
            android:text="Cancel"
            android:textColor="@color/text_primary" />

        <Button
            android:id="@+id/btn_confirm_logout"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="@dimen/space_8"
            android:layout_weight="1"
            android:background="@drawable/bg_danger_pill"
            android:text="Sign Out"
            android:textColor="@color/status_danger" />
    </LinearLayout>
</LinearLayout>
