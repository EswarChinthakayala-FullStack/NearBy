<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- BACKGROUND GRID PATTERN -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.2"
        android:contentDescription="Grid Pattern"
        android:scaleType="fitXY"
        android:src="@drawable/bg_grid_pattern" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <com.example.nearby.designsystem.EmeraldToolbar
            android:id="@+id/editProfileToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewEditProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- AVATAR PHOTO SECTION -->
                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="24dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardEditAvatar"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardBackgroundColor="@color/emerald_500"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="6dp">

                        <ImageView
                            android:id="@+id/ivEditAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvEditAvatarInitial"
                            style="@style/Typography.HeadlineLarge"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            tools:text="A" />
                    </androidx.cardview.widget.CardView>

                    <!-- CAMERA BADGE OVERLAY -->
                    <ImageView
                        android:id="@+id/btnChangeAvatar"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_alignBottom="@id/cardEditAvatar"
                        android:layout_alignEnd="@id/cardEditAvatar"
                        android:background="@drawable/bg_button_primary"
                        android:contentDescription="Change Photo"
                        android:padding="8dp"
                        android:src="@drawable/ic_camera"
                        app:tint="@color/white" />
                </RelativeLayout>

                <!-- SECTION 1: BASIC INFORMATION -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BASIC INFORMATION"
                    android:textColor="@color/emerald_400"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- FULL NAME INPUT -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Full Name *"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etFullName"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_panel"
                    android:hint="Enter your full name"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13.5sp" />

                <TextView
                    android:id="@+id/tvErrorFullName"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/red_400"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <!-- USERNAME INPUT -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Username"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etUsername"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_panel"
                    android:hint="@username (e.g. alex_travels)"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13.5sp" />

                <!-- GENDER SELECTOR ROW -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Gender Identity"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnGenderMale"
                        style="@style/Typography.Caption"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_panel"
                        android:gravity="center"
                        android:text="Male"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnGenderFemale"
                        style="@style/Typography.Caption"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_panel"
                        android:gravity="center"
                        android:text="Female"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnGenderOther"
                        style="@style/Typography.Caption"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_panel"
                        android:gravity="center"
                        android:text="Other"
                        android:textColor="@color/text_secondary"
                        android:textSize="12.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- SECTION 2: BIOGRAPHY -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp">

                    <TextView
                        style="@style/Typography.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:text="TRAVEL BIOGRAPHY"
                        android:textColor="@color/emerald_400"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvBioCharCount"
                        style="@style/Typography.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        tools:text="0 / 250" />
                </RelativeLayout>

                <EditText
                    android:id="@+id/etBio"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="top|start"
                    android:hint="Tell other travelers about your passions, favorite style, or trips..."
                    android:maxLength="250"
                    android:padding="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13.5sp" />

                <!-- SECTION 3: CONTACT INFORMATION -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="CONTACT INFORMATION"
                    android:textColor="@color/emerald_400"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- EMAIL ADDRESS (READ-ONLY) -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Email Address (Verified)"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_panel"
                    android:enabled="false"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_muted"
                    android:textSize="13.5sp"
                    tools:text="alex.morgan@example.com" />

                <!-- PHONE NUMBER INPUT -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Phone Number"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <EditText
                    android:id="@+id/etPhone"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_glass_panel"
                    android:hint="+1 (555) 000-0000"
                    android:inputType="phone"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13.5sp" />

                <!-- SECTION 4: LOCATION & PREFERENCES -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="LOCATION &amp; LANGUAGE"
                    android:textColor="@color/emerald_400"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <!-- AUTO DETECT GPS LOCATION BUTTON -->
                <TextView
                    android:id="@+id/btnAutoDetectLocation"
                    style="@style/Typography.Button"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:text="⚡ Auto-Detect Location via GPS"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    android:textStyle="bold" />

                <!-- COUNTRY PICKER -->
                <TextView
                    android:id="@+id/btnSelectCountry"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13.5sp"
                    tools:text="Country: United States" />

                <!-- CITY & STATE -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnSelectState"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_panel"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        tools:text="State: California" />

                    <TextView
                        android:id="@+id/btnSelectCity"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_glass_panel"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="14dp"
                        android:textColor="@color/text_primary"
                        android:textSize="13.5sp"
                        tools:text="City: San Francisco" />
                </LinearLayout>

                <!-- SAVE BUTTON -->
                <TextView
                    android:id="@+id/btnSaveProfile"
                    style="@style/Typography.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="32dp"
                    android:background="@drawable/bg_button_primary"
                    android:gravity="center"
                    android:text="Save Profile Changes  →"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- SUCCESS OVERLAY CONTAINER -->
    <LinearLayout
        android:id="@+id/layoutSaveSuccessOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#D0000000"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            style="@style/Typography.HeadlineLarge"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_emerald"
            android:gravity="center"
            android:text="✓"
            android:textColor="@color/white"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Typography.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Profile Updated Successfully"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Typography.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Your account changes have been saved."
            android:textColor="@color/zinc_300"
            android:textSize="13.5sp" />
    </LinearLayout>

</FrameLayout>
