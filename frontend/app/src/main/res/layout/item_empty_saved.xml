<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_32">

    <!-- CUSTOM GLASS HEART ILLUSTRATION CONTAINER -->
    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:background="@drawable/bg_glass_panel"
        android:padding="24dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Empty Favorites"
            android:src="@drawable/ic_heart"
            app:tint="@color/emerald_400" />
    </FrameLayout>

    <TextView
        style="@style/Typography.HeadlineLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_20"
        android:text="No Saved Destinations Yet"
        android:textColor="@color/white" />

    <TextView
        style="@style/Typography.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center"
        android:text="Tap the heart icon on any place card to bookmark your favorite travel spots for quick offline access."
        android:textColor="@color/text_secondary" />

    <Button
        android:id="@+id/btnExplorePlaces"
        style="@style/Typography.Button"
        android:layout_width="220dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_24"
        android:background="@drawable/bg_button_primary"
        android:text="Explore Places ➔"
        android:textColor="@color/white" />
</LinearLayout>
