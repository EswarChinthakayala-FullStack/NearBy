<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingBottom="12dp">

    <!-- LEFT COLUMN: VERTICAL TIMELINE ROAD LINE & NUMBER BADGE -->
    <RelativeLayout
        android:layout_width="40dp"
        android:layout_height="140dp"
        android:gravity="center_horizontal">

        <!-- Top connecting road line -->
        <View
            android:id="@+id/viewRoadLineTop"
            android:layout_width="3dp"
            android:layout_height="16dp"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_road_line" />

        <!-- Waypoint Place Sequence Number Badge -->
        <RelativeLayout
            android:id="@+id/layoutWaypointNode"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_below="@id/viewRoadLineTop"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_waypoint_number">

            <TextView
                android:id="@+id/tvWaypointNumber"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="1" />
        </RelativeLayout>

        <!-- Bottom connecting road line -->
        <View
            android:id="@+id/viewRoadLineBottom"
            android:layout_width="3dp"
            android:layout_height="match_parent"
            android:layout_below="@id/layoutWaypointNode"
            android:layout_centerHorizontal="true"
            android:background="@drawable/bg_road_line" />
    </RelativeLayout>

    <!-- RIGHT COLUMN: WAYPOINT ACTIVITY DETAILS CARD -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- TIME SLOT & DURATION ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Time Slot Badge -->
                <TextView
                    android:id="@+id/tv_act_time"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_emerald_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:textColor="@color/emerald_400"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="⏰ 09:00 AM" />

                <!-- Visit Duration Badge -->
                <TextView
                    android:id="@+id/tv_act_duration"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_glass_panel"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    tools:text="⏱️ 2h visit" />
            </LinearLayout>

            <!-- Activity / Place Title -->
            <TextView
                android:id="@+id/tv_act_name"
                style="@style/Typography.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                tools:text="📍 Golconda Fort Heritage Walk" />

            <!-- AI Reason / Visit Recommendation -->
            <TextView
                android:id="@+id/tv_act_reason"
                style="@style/Typography.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                tools:text="Top rated historical fortress. Early visit avoids peak heat and queues." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="10dp"
                android:background="@color/divider_color" />

            <!-- Action Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_act_view_place"
                    style="@style/Typography.Caption"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center"
                    android:text="📍 View Details"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_act_navigate"
                    style="@style/Typography.Caption"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_emerald_badge"
                    android:gravity="center"
                    android:text="🛣️ Directions ➔"
                    android:textColor="@color/emerald_400"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>
