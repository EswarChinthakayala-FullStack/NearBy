<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <com.example.nearby.designsystem.EmeraldToolbar
        android:id="@+id/detailEmeraldToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="240dp">

                <ImageView
                    android:id="@+id/iv_detail_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Destination Hero"
                    android:scaleType="centerCrop" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_gradient_overlay" />

                <!-- Road Route Badge overlay -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_agent_pill"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="🛣️ Verified OSRM Road Route"
                    android:textColor="@color/emerald_400"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tv_detail_title"
                        style="@style/Typography.HeadlineSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        tools:text="1-Day Heritage Tour in Ongole" />

                    <TextView
                        android:id="@+id/tv_detail_destination"
                        style="@style/Typography.Subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/emerald_400"
                        tools:text="📍 Ongole, Andhra Pradesh • 1 Day" />
                </LinearLayout>
            </RelativeLayout>

            <!-- USER'S ORIGINAL REQUEST PROMPT CARD -->
            <LinearLayout
                android:id="@+id/card_user_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_emerald_badge"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="Prompt Icon"
                            android:src="@drawable/ic_prompt"
                            app:tint="@color/emerald_400" />

                        <TextView
                            style="@style/Typography.Subtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="My Request"
                            android:textColor="@color/emerald_400"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_copy_prompt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:contentDescription="Copy"
                            android:src="@drawable/ic_copy"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/Typography.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="Copy Prompt"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </RelativeLayout>

                <TextView
                    android:id="@+id/tv_detail_prompt_text"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:textSize="13.5sp"
                    tools:text="&quot;Plan a 1-day heritage trip in Ongole visiting famous temples and local food&quot;" />
            </LinearLayout>

            <!-- ROAD ROUTE WEATHER FORECAST CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass_panel"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Typography.Subtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🌤️ Weather Forecast"
                        android:textColor="@color/emerald_400" />

                    <TextView
                        android:id="@+id/tv_detail_weather_temp"
                        style="@style/Typography.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_agent_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/emerald_400"
                        android:textStyle="bold"
                        tools:text="26.0°C • Clear" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_detail_weather_rec"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_secondary"
                    tools:text="Ideal weather for road transit and outdoor monument sightseeing." />
            </LinearLayout>

            <!-- AI ROAD OVERVIEW SUMMARY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_chat_bubble_ai"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/Typography.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 AI Strategy &amp; Overview"
                    android:textColor="@color/emerald_400" />

                <TextView
                    android:id="@+id/tv_detail_summary"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text_primary"
                    tools:text="This itinerary synthesizes heritage temples and local cuisine with live OSRM routing." />
            </LinearLayout>

            <!-- DAY TIMELINE SECTION HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Typography.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛣️ Waypoint Timeline"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_suggestion_chip"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Connected Route"
                    android:textColor="@color/emerald_400"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- DAY TIMELINE RECYCLERVIEW -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detail_timeline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
