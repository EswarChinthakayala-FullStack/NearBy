<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/category_card_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/space_12"
    android:background="@drawable/bg_glass_panel"
    android:elevation="@dimen/shadow_small"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_12">

    <TextView
        android:id="@+id/tv_category_icon"
        style="@style/Typography.HeadlineSmall"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏖" />

    <TextView
        android:id="@+id/tv_category_name"
        style="@style/Typography.BodyMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_8"
        android:text="Beaches"
        android:textColor="@color/text_primary" />

</LinearLayout>
