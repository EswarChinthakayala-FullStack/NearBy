<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- TOOLBAR -->
    <com.example.nearby.designsystem.EmeraldToolbar
        android:id="@+id/aboutToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <androidx.cardview.widget.CardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/emerald_500"
                app:cardCornerRadius="40dp"
                app:cardElevation="6dp">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_app_logo"
                    app:tint="@color/white" />
            </androidx.cardview.widget.CardView>

            <TextView
                style="@style/Typography.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Nearby Travel Guide"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_button_primary"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:text="Version 2.0.0 (Build 206)"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Typography.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Enterprise AI travel intelligence platform providing smart itineraries, real-time spatial navigation, and destination recommendations."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- SYSTEM & BACKEND DETAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/rowBackendVersion"
                    layout="@layout/item_profile_info_row" />

                <include
                    android:id="@+id/rowApiStatus"
                    layout="@layout/item_profile_info_row" />

                <include
                    android:id="@+id/rowDeveloper"
                    layout="@layout/item_profile_info_row" />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
