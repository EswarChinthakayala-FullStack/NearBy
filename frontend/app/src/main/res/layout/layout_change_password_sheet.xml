<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_solid_drawer_panel"
    android:elevation="@dimen/shadow_large"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_24"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_24">

    <!-- DRAG HANDLE BAR -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3F3F46" />

    <!-- TITLE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Typography.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Change Password"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btn_close_change_pass"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/space_12"
        android:background="#27272A" />

    <!-- CURRENT PASSWORD -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CURRENT PASSWORD"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_current_password"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/space_12"
        android:textColor="@color/text_primary" />

    <!-- NEW PASSWORD -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="NEW PASSWORD"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_new_password"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/space_12"
        android:textColor="@color/text_primary" />

    <!-- PASSWORD STRENGTH INDICATOR -->
    <TextView
        android:id="@+id/tv_password_strength"
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Strength: None"
        android:textColor="@color/emerald_500" />

    <!-- CONFIRM NEW PASSWORD -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:text="CONFIRM NEW PASSWORD"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/et_confirm_password"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_input_field"
        android:inputType="textPassword"
        android:paddingHorizontal="@dimen/space_12"
        android:textColor="@color/text_primary" />

    <!-- INLINE ERROR MESSAGE -->
    <TextView
        android:id="@+id/tv_change_pass_error"
        style="@style/Typography.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:textColor="@color/status_danger"
        android:visibility="gone" />

    <!-- SUBMIT BUTTON -->
    <Button
        android:id="@+id/btn_submit_change_pass"
        style="@style/Typography.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_20"
        android:background="@drawable/bg_button_primary"
        android:text="Update Password  →"
        android:textColor="@color/white" />
</LinearLayout>
