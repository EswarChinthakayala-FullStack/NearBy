<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="4dp">

    <!-- AI Avatar & Name Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨"
            android:textSize="14sp" />

        <TextView
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Nearby AI"
            android:textColor="@color/emerald_400"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Glassmorphism Bubble -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="48dp"
        android:background="@drawable/bg_chat_bubble_ai"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp">

        <TextView
            android:id="@+id/tv_chat_ai_text"
            style="@style/Typography.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_primary"
            tools:text="I've generated a 2-day travel itinerary for Hyderabad!" />

        <!-- View Itinerary Button -->
        <TextView
            android:id="@+id/btn_chat_view_itinerary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_suggestion_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="View Itinerary ➔"
            android:textColor="@color/emerald_400"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Agent attribution -->
        <TextView
            android:id="@+id/tv_agent_attribution"
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:visibility="gone"
            tools:text="Generated by Travel Itinerary Architect"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>
