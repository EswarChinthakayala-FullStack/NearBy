<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_solid_drawer_panel"
    android:elevation="@dimen/shadow_large"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_24"
    android:paddingTop="@dimen/space_12"
    android:paddingBottom="@dimen/space_24">

    <!-- DRAG HANDLE BAR -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#3F3F46" />

    <!-- TITLE HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Typography.HeadlineMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Write a Review"
            android:textColor="@color/text_primary" />

        <ImageView
            android:id="@+id/btn_close_review"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Close"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="@dimen/space_12"
        android:background="#27272A" />

    <!-- RATING SELECTOR -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YOUR RATING"
        android:textColor="@color/text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_horizontal"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/star1"
            style="@style/Typography.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="★"
            android:textColor="@color/status_warning" />

        <TextView
            android:id="@+id/star2"
            style="@style/Typography.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="★"
            android:textColor="@color/status_warning" />

        <TextView
            android:id="@+id/star3"
            style="@style/Typography.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="★"
            android:textColor="@color/status_warning" />

        <TextView
            android:id="@+id/star4"
            style="@style/Typography.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="★"
            android:textColor="@color/status_warning" />

        <TextView
            android:id="@+id/star5"
            style="@style/Typography.HeadlineLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="★"
            android:textColor="@color/status_warning" />
    </LinearLayout>

    <!-- REVIEW TEXT INPUT -->
    <EditText
        android:id="@+id/et_review_text"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:layout_marginTop="@dimen/space_12"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:hint="Share your experience at this destination..."
        android:padding="@dimen/space_12"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted" />

    <!-- INLINE VALIDATION ERROR TEXT -->
    <TextView
        android:id="@+id/tv_review_error"
        style="@style/Typography.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:textColor="@color/status_danger"
        android:visibility="gone" />

    <!-- SUBMIT BUTTON -->
    <Button
        android:id="@+id/btn_submit_review"
        style="@style/Typography.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/space_16"
        android:background="@drawable/bg_button_primary"
        android:text="Submit Review  →"
        android:textColor="@color/white" />

</LinearLayout>
