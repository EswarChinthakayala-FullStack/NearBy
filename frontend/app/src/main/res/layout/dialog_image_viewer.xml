<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FA000000">

    <!-- FULLSCREEN VIEWPAGER2 -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp_image_viewer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- FLOATING TOP GLASS TOOLBAR -->
    <LinearLayout
        android:id="@+id/viewer_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#B309090B"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/space_16"
        android:paddingVertical="@dimen/space_12">

        <ImageButton
            android:id="@+id/btn_viewer_close"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />

        <TextView
            android:id="@+id/tv_viewer_counter"
            style="@style/Typography.HeadlineSmall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:textColor="@color/white"
            tools:text="3 / 42" />

        <ImageButton
            android:id="@+id/btn_viewer_download"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Download to MediaStore"
            android:src="@drawable/ic_download"
            app:tint="@color/emerald_400" />

        <ImageButton
            android:id="@+id/btn_viewer_share"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share Image"
            android:src="@drawable/ic_share"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btn_viewer_refresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Refresh Image"
            android:src="@drawable/ic_search"
            app:tint="@color/emerald_400" />
    </LinearLayout>

    <!-- BOTTOM CAPTION OVERLAY -->
    <LinearLayout
        android:id="@+id/layout_viewer_bottom_caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#B309090B"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <TextView
            android:id="@+id/tv_viewer_title"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            tools:text="Lotus Temple Full HD View" />

        <TextView
            android:id="@+id/tv_viewer_source"
            style="@style/Typography.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/emerald_400"
            tools:text="Source: Wikimedia Scraper" />
    </LinearLayout>

</FrameLayout>
