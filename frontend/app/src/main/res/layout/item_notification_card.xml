<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/bg_glass_panel"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <!-- TAG BADGE ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNotificationTag"
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_neutral_pill"
            android:paddingHorizontal="@dimen/space_12"
            android:paddingVertical="@dimen/space_4"
            android:textColor="@color/emerald_400"
            android:textSize="11sp"
            tools:text="Security &amp; Auth" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/btnCloseNotification"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Dismiss"
            android:src="@drawable/ic_close"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- TITLE -->
    <TextView
        android:id="@+id/tvNotificationTitle"
        style="@style/Typography.HeadlineSmall"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:textColor="@color/white"
        tools:text="Account Authentication Verified" />

    <!-- MESSAGE BODY -->
    <TextView
        android:id="@+id/tvNotificationMessage"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/text_secondary"
        tools:text="Your Nearby account profile authentication token is active and secure." />

    <!-- BOTTOM ROW: TIMESTAMP & VIEW LINK -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvNotificationTime"
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            tools:text="2 days ago" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnViewPage"
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Page 🔗"
            android:textColor="@color/emerald_400" />
    </LinearLayout>

</LinearLayout>
