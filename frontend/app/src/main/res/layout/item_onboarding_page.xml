<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/space_20"
    android:paddingVertical="@dimen/space_16">

    <!-- 32dp ROUNDED FLOATING GLASS CARD PANEL -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_glass_panel"
        android:elevation="@dimen/shadow_large"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingVertical="@dimen/space_32">

        <!-- Page Illustration Container -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:background="@drawable/bg_glass_card"
            android:elevation="@dimen/shadow_medium"
            android:padding="@dimen/space_24">

            <ImageView
                android:id="@+id/iv_onboarding_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Illustration"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_app_logo" />
        </FrameLayout>

        <!-- Page Title -->
        <TextView
            android:id="@+id/tv_onboarding_title"
            style="@style/Typography.DisplayLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_24"
            android:text="Discover Hidden Destinations"
            android:textAlignment="center"
            android:textColor="@color/text_primary" />

        <!-- Page Subtitle -->
        <TextView
            android:id="@+id/tv_onboarding_subtitle"
            style="@style/Typography.BodyLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:text="Find breathtaking tourist attractions, local gems, and unforgettable experiences near you."
            android:textAlignment="center"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

</FrameLayout>
