<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_premium_toolbar"
    android:elevation="8dp"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- USER AVATAR, GREETING & NOTIFICATION ROW -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- USER AVATAR CARD -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardUserAvatar"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            app:cardBackgroundColor="@color/bg_surface"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/tvAvatarInitial"
                style="@style/Typography.Title"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_emerald_gradient"
                android:gravity="center"
                android:textColor="@color/white"
                tools:text="E" />
        </androidx.cardview.widget.CardView>

        <!-- GREETING & LOCATION -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/space_12"
            android:layout_toEndOf="@+id/cardUserAvatar"
            android:layout_toStartOf="@+id/layoutRightActions"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvGreeting"
                style="@style/Typography.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="17sp"
                tools:text="Hello, Eswar 👋" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="Location"
                    android:src="@drawable/ic_location"
                    app:tint="@color/emerald_200" />

                <TextView
                    android:id="@+id/tvCurrentLocation"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="Hyderabad, India"
                    android:textColor="@color/emerald_200" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT ACTION ICONS WITH GLASS BACKGROUND -->
        <LinearLayout
            android:id="@+id/layoutRightActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnSearchShortcut"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_glass_icon_btn"
                android:contentDescription="Search"
                android:padding="8dp"
                android:src="@drawable/ic_search"
                app:tint="@color/white" />

            <FrameLayout
                android:id="@+id/btnNotification"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_glass_icon_btn">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/white" />

                <TextView
                    android:id="@+id/tvNotificationBadge"
                    style="@style/Typography.Caption"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_circle_emerald"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>
