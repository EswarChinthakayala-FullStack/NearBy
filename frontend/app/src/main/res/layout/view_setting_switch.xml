<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_glass_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <ImageView
        android:id="@+id/ivSwitchIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_check"
        app:tint="@color/emerald_400" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSwitchTitle"
            style="@style/Typography.BodyMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Trip Reminders" />

        <TextView
            android:id="@+id/tvSwitchSubtitle"
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            tools:text="Get push alerts for upcoming itinerary activities" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/viewSwitchTrack"
        android:layout_width="52dp"
        android:layout_height="28dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_glass_panel"
        android:padding="3dp">

        <View
            android:id="@+id/viewSwitchThumb"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_circle_emerald" />
    </FrameLayout>
</LinearLayout>
