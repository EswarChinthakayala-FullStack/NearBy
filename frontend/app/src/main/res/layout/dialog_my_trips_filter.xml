<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- SORT BY SECTION -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT BY"
        android:textColor="@color/emerald_400"
        android:textSize="11sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTripSortBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbSortNewest"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:checked="true"
            android:text="Newest First"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSortOldest"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Oldest First"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSortMostPlaces"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Most Places Planned"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbSortLongest"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Longest Duration (Days)"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- STATUS FILTER SECTION -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="TRIP STATUS"
        android:textColor="@color/emerald_400"
        android:textSize="11sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgTripStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

        <RadioButton
            android:id="@+id/rbStatusAll"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:checked="true"
            android:text="All Statuses"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbStatusCompleted"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Completed Trips"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/rbStatusPlanning"
            style="@style/Typography.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:buttonTint="@color/emerald_500"
            android:text="Planning / Draft"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />
    </RadioGroup>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnResetTripFilters"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center"
            android:text="Reset"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnApplyTripFilters"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_emerald_badge"
            android:gravity="center"
            android:text="Apply Filters"
            android:textColor="@color/emerald_400"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
