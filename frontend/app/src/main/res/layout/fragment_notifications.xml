<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary"
    android:orientation="vertical">

    <!-- FLOATING TOP TOOLBAR -->
    <com.example.nearby.designsystem.EmeraldToolbar
        android:id="@+id/notificationsToolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <!-- MAIN SCROLL CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16"
            android:paddingTop="@dimen/space_16">

            <!-- TOP TITLE & CLEAR ALL BAR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Typography.HeadlineLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Notifications &amp; Live Alerts"
                        android:textColor="@color/text_primary" />

                    <TextView
                        style="@style/Typography.BodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Real-time travel updates, review moderation events, and AI recommendations."
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <!-- CLEAR ALL BUTTON -->
                <TextView
                    android:id="@+id/btnClearAll"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_danger_pill"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="@dimen/space_12"
                    android:paddingVertical="@dimen/space_6"
                    android:text="Clear All"
                    android:textColor="@color/status_danger" />
            </LinearLayout>

            <!-- HORIZONTAL SCROLLING FILTER CHIPS -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterChipsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- RECYCLER VIEW LIST -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:nestedScrollingEnabled="false"
                tools:itemCount="4"
                tools:listitem="@layout/item_notification_card" />

            <!-- EMPTY STATE -->
            <LinearLayout
                android:id="@+id/containerEmptyNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="Empty"
                    android:src="@drawable/ic_notification"
                    app:tint="@color/text_muted" />

                <TextView
                    style="@style/Typography.HeadlineSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="No Notifications"
                    android:textColor="@color/white" />

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="You're all caught up! Check back later for travel updates."
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
