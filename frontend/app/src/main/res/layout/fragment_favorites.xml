<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/favorites_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- BACKGROUND GRID PATTERN -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:contentDescription="Grid Pattern"
        android:scaleType="fitXY"
        android:src="@drawable/bg_grid_pattern" />

    <!-- MAIN VERTICAL CONTAINER WITH FIXED TOP TOOLBAR & SCROLLING CONTENT BELOW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- SOLID FIXED TOP TOOLBAR (NEVER OVERLAPS SEARCH BAR) -->
        <com.example.nearby.designsystem.EmeraldToolbar
            android:id="@+id/favoritesToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/favoritesScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- PREMIUM CUSTOM SEARCH VIEW (SITS CLEANLY BELOW TOOLBAR) -->
                <com.example.nearby.designsystem.PremiumSearchView
                    android:id="@+id/searchViewSaved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_16" />

                <!-- HORIZONTAL CATEGORY FILTERS ROW -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCategoryFilters"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:clipToPadding="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16" />

                <!-- FAVORITES COUNT & SORT INDICATOR HEADER -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/space_16"
                    android:layout_marginTop="@dimen/space_16"
                    android:layout_marginBottom="@dimen/space_8">

                    <TextView
                        android:id="@+id/tvFavoritesCountLabel"
                        style="@style/Typography.HeadlineSmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:textColor="@color/text_primary"
                        tools:text="Saved Places (0)" />

                    <TextView
                        android:id="@+id/tvSortIndicator"
                        style="@style/Typography.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/bg_skip_pill"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/emerald_400"
                        tools:text="Sorted by Recently Saved" />
                </RelativeLayout>

                <!-- SAVED PLACES RECYCLER VIEW -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFavorites"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_favorite_place" />

                <!-- EMPTY STATE CONTAINER -->
                <include
                    android:id="@+id/layoutEmptyState"
                    layout="@layout/item_empty_saved"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <!-- FLOATING SCROLL-TO-TOP BUTTON -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabScrollTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Scroll to top"
        android:src="@drawable/ic_arrow_up"
        android:visibility="gone"
        app:backgroundTint="@color/emerald_500"
        app:tint="@color/white" />

</FrameLayout>
