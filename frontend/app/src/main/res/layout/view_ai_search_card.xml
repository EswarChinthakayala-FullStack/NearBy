<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_panel"
    android:elevation="6dp"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <!-- TOP AI SPARK HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="AI Spark"
            android:src="@drawable/ic_ai_nearby_selected" />

        <TextView
            style="@style/Typography.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="AI Location Assistant"
            android:textColor="@color/emerald_400" />
    </LinearLayout>

    <!-- MULTI-LINE INPUT FIELD -->
    <EditText
        android:id="@+id/etAiQuery"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@null"
        android:hint="Ask anything nearby... (e.g. Best historical places with family)"
        android:imeOptions="actionSearch"
        android:inputType="textMultiLine"
        android:maxLines="3"
        android:minLines="2"
        android:textColor="@color/white"
        android:textColorHint="@color/text_muted" />

    <!-- ACTION BUTTONS ROW -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <ImageButton
            android:id="@+id/btnVoiceSearch"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_alignParentStart="true"
            android:background="@drawable/bg_glass_icon_btn"
            android:contentDescription="Voice Search"
            android:padding="8dp"
            android:src="@drawable/ic_voice"
            app:tint="@color/emerald_400" />

        <Button
            android:id="@+id/btnSendQuery"
            style="@style/Typography.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="20dp"
            android:text="Ask AI ✨"
            android:textColor="@color/white" />
    </RelativeLayout>
</LinearLayout>
