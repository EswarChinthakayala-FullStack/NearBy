<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- BACKGROUND GRID PATTERN -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:contentDescription="Grid Pattern"
        android:scaleType="fitXY"
        android:src="@drawable/bg_grid_pattern" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TOOLBAR -->
        <com.example.nearby.designsystem.EmeraldToolbar
            android:id="@+id/profileToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/profileScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="120dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- EXECUTIVE PROFILE HEADER CONTAINER -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_emerald_gradient"
                    android:paddingHorizontal="20dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp">

                    <!-- AVATAR PHOTO -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardProfileAvatar"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        app:cardBackgroundColor="@color/emerald_500"
                        app:cardCornerRadius="42dp"
                        app:cardElevation="6dp">

                        <ImageView
                            android:id="@+id/ivAvatar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tvUserInitial"
                            style="@style/Typography.HeadlineMedium"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textColor="@color/white"
                            android:textSize="32sp"
                            android:textStyle="bold"
                            tools:text="A" />
                    </androidx.cardview.widget.CardView>

                    <!-- NAME & USERNAME -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="16dp"
                        android:layout_toEndOf="@id/cardProfileAvatar"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvUserName"
                                style="@style/Typography.Title"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/white"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="Alex Morgan" />

                            <ImageView
                                android:id="@+id/ivVerifiedBadge"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_check"
                                app:tint="@color/emerald_400" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvUserHandle"
                            style="@style/Typography.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/emerald_200"
                            android:textSize="12.5sp"
                            tools:text="@alex_morgan • Level 4 Explorer" />

                        <TextView
                            android:id="@+id/tvUserEmail"
                            style="@style/Typography.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textColor="@color/zinc_300"
                            android:textSize="12sp"
                            tools:text="alex.morgan@example.com" />

                        <TextView
                            android:id="@+id/btnQuickEditProfile"
                            style="@style/Typography.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_button_primary"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"
                            android:text="Edit Profile  ✎"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </RelativeLayout>

                <!-- STATISTICS DASHBOARD SECTION -->
                <LinearLayout
                    android:id="@+id/layoutProfileStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <!-- CARD 1: TRIPS -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardStatTrips"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvTripsCount"
                                style="@style/Typography.HeadlineSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/emerald_400"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="8" />

                            <TextView
                                style="@style/Typography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Trips"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD 2: REVIEWS -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardStatReviews"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvReviewsCount"
                                style="@style/Typography.HeadlineSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/amber_400"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="14" />

                            <TextView
                                style="@style/Typography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Reviews"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD 3: SAVED PLACES -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardStatSaved"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvSavedCount"
                                style="@style/Typography.HeadlineSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="24" />

                            <TextView
                                style="@style/Typography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Favorites"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CARD 4: COUNTRIES -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardStatCountries"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/bg_surface"
                        app:cardCornerRadius="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvCountriesCount"
                                style="@style/Typography.HeadlineSmall"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/emerald_400"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                tools:text="5" />

                            <TextView
                                style="@style/Typography.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Countries"
                                android:textColor="@color/text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- PERSONAL INFORMATION SECTION -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="PERSONAL INFORMATION"
                    android:textColor="@color/emerald_400"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:orientation="vertical">

                    <!-- NAME ROW -->
                    <include
                        android:id="@+id/rowFullName"
                        layout="@layout/item_profile_info_row" />

                    <!-- USERNAME ROW -->
                    <include
                        android:id="@+id/rowUsername"
                        layout="@layout/item_profile_info_row" />

                    <!-- PHONE ROW -->
                    <include
                        android:id="@+id/rowPhone"
                        layout="@layout/item_profile_info_row" />

                    <!-- LOCATION ROW -->
                    <include
                        android:id="@+id/rowLocation"
                        layout="@layout/item_profile_info_row" />
                </LinearLayout>

                <!-- ACCOUNT & MENU SETTINGS -->
                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="8dp"
                    android:text="ACCOUNT MANAGEMENT"
                    android:textColor="@color/emerald_400"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAccountMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingHorizontal="16dp" />

                <!-- DANGER ZONE / SIGN OUT -->
                <TextView
                    android:id="@+id/btnSignOut"
                    style="@style/Typography.Button"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center"
                    android:text="Sign Out Account"
                    android:textColor="@color/red_400"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</FrameLayout>
