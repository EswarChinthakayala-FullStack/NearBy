<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/my_trips_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_primary">

    <!-- BACKGROUND GRID PATTERN -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.25"
        android:contentDescription="Grid Pattern"
        android:scaleType="fitXY"
        android:src="@drawable/bg_grid_pattern" />

    <!-- MAIN VERTICAL CONTAINER WITH FIXED TOP TOOLBAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- SOLID FIXED TOP TOOLBAR -->
        <com.example.nearby.designsystem.EmeraldToolbar
            android:id="@+id/myTripsToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/tripsScrollView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="120dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- STATISTICS SUMMARY DASHBOARD -->
                    <LinearLayout
                        android:id="@+id/layoutTripStatistics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <!-- CARD 1: TOTAL TRIPS -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/bg_surface"
                            app:cardCornerRadius="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvStatTotalTrips"
                                    style="@style/Typography.HeadlineSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/emerald_400"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="8" />

                                <TextView
                                    style="@style/Typography.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Total Trips"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- CARD 2: CITIES VISITED -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/bg_surface"
                            app:cardCornerRadius="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvStatCitiesVisited"
                                    style="@style/Typography.HeadlineSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/amber_400"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="5" />

                                <TextView
                                    style="@style/Typography.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Destinations"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- CARD 3: PLACES PLANNED -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="6dp"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/bg_surface"
                            app:cardCornerRadius="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvStatPlacesPlanned"
                                    style="@style/Typography.HeadlineSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/text_primary"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="48" />

                                <TextView
                                    style="@style/Typography.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Places"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- CARD 4: TRAVEL DAYS -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:cardBackgroundColor="@color/bg_surface"
                            app:cardCornerRadius="14dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <TextView
                                    android:id="@+id/tvStatTravelDays"
                                    style="@style/Typography.HeadlineSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/emerald_400"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    tools:text="18" />

                                <TextView
                                    style="@style/Typography.Caption"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Days"
                                    android:textColor="@color/text_muted"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </androidx.cardview.widget.CardView>
                    </LinearLayout>

                    <!-- SEARCH BAR -->
                    <com.example.nearby.designsystem.PremiumSearchView
                        android:id="@+id/searchViewTrips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp" />

                    <!-- HORIZONTAL CATEGORY & THEME FILTERS ROW -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTripCategoryFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp" />

                    <!-- TRIPS COUNT & SORT INDICATOR HEADER -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/tvTripsCountLabel"
                            style="@style/Typography.HeadlineSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="My Itineraries (8)" />

                        <TextView
                            android:id="@+id/tvTripSortIndicator"
                            style="@style/Typography.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/bg_skip_pill"
                            android:paddingHorizontal="10dp"
                            android:paddingVertical="4dp"
                            android:textColor="@color/emerald_400"
                            tools:text="Sorted by Newest" />
                    </RelativeLayout>

                    <!-- SKELETON SHIMMER CONTAINER -->
                    <include
                        android:id="@+id/layoutShimmerTripsContainer"
                        layout="@layout/shimmer_trip_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <!-- TRIPS RECYCLER VIEW -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvTrips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_trip_card" />

                    <!-- EMPTY STATE CONTAINER -->
                    <LinearLayout
                        android:id="@+id/layoutEmptyTrips"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="96dp"
                            android:alpha="0.8"
                            android:src="@drawable/ic_trips"
                            app:tint="@color/emerald_400" />

                        <TextView
                            style="@style/Typography.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="No Trips Yet"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            style="@style/Typography.BodyMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center"
                            android:text="Create your first AI itinerary and start exploring amazing tourist destinations."
                            android:textColor="@color/text_secondary"
                            android:textSize="13.5sp" />

                        <TextView
                            android:id="@+id/btnCreateTrip"
                            style="@style/Typography.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginTop="20dp"
                            android:background="@drawable/bg_button_primary"
                            android:gravity="center"
                            android:paddingHorizontal="24dp"
                            android:text="Create AI Trip  →"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <!-- FLOATING ACTION BUTTON FOR CREATE TRIP -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCreateTripMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:contentDescription="Create AI Trip"
        android:src="@drawable/ic_sparkles"
        app:backgroundTint="@color/emerald_500"
        app:tint="@color/white" />

</FrameLayout>
