<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_12"
    android:background="@drawable/bg_glass_panel"
    android:elevation="@dimen/shadow_small"
    android:orientation="vertical"
    android:padding="@dimen/space_16">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/iv_reviewer_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_skip_pill"
                android:contentDescription="Avatar"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_reviewer_initial"
                style="@style/Typography.HeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_emerald_gradient"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Y" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_reviewer_name"
                style="@style/Typography.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                tools:text="Aarav Sharma" />

            <TextView
                android:id="@+id/tv_review_date"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                tools:text="2 days ago" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_review_rating"
            style="@style/Typography.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_skip_pill"
            android:paddingHorizontal="@dimen/space_8"
            android:paddingVertical="4dp"
            android:textColor="@color/emerald_400"
            android:textStyle="bold"
            tools:text="★ 5.0" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_review_content"
        style="@style/Typography.BodyMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_12"
        android:textColor="@color/text_primary"
        tools:text="Breathtaking architectural wonder! The historical detail and craftsmanship are incredible." />

</LinearLayout>
