<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/facility_chip_container"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:background="@drawable/bg_category_chip_selected"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp">

    <ImageView
        android:id="@+id/iv_facility_icon"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginEnd="6dp"
        android:contentDescription="Facility Icon"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check"
        app:tint="@color/emerald_400" />

    <TextView
        android:id="@+id/tv_facility_name"
        style="@style/Typography.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/emerald_400"
        android:textSize="13sp"
        tools:text="Guided Tours" />
</LinearLayout>
