<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/search_panel_container"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginHorizontal="@dimen/space_16"
    android:background="@drawable/bg_glass_panel"
    android:elevation="@dimen/shadow_medium"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/space_16">

    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="Search Icon"
        android:src="@drawable/ic_search" />

    <EditText
        android:id="@+id/et_search"
        style="@style/Typography.BodyLarge"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:hint="Search places, beaches, hotels..."
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:textColorHint="@color/text_muted" />

    <ImageButton
        android:id="@+id/btn_clear_search"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Clear Search"
        android:src="@drawable/ic_clear"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/btn_voice_search"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Voice Search"
        android:src="@drawable/ic_voice" />

</LinearLayout>
