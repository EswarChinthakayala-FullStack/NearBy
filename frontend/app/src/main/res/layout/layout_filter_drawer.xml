<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- SORT BY SECTION -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SORT BY"
        android:textColor="@color/emerald_400"
        android:textSize="11sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgSortBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbSortRecentlySaved"
            style="@style/Typography.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/emerald_500"
            android:checked="true"
            android:text="Recent"
            android:textColor="@color/white"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbSortAlphabetical"
            style="@style/Typography.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/emerald_500"
            android:text="A - Z"
            android:textColor="@color/white"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbSortRating"
            style="@style/Typography.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/emerald_500"
            android:text="Rating ★"
            android:textColor="@color/white"
            android:textSize="12.5sp" />
    </RadioGroup>

    <!-- MINIMUM RATING SECTION -->
    <TextView
        style="@style/Typography.Caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="MINIMUM RATING"
        android:textColor="@color/emerald_400"
        android:textSize="11sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgRating"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbRatingAny"
            style="@style/Typography.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/emerald_500"
            android:checked="true"
            android:text="Any"
            android:textColor="@color/white"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbRating4Plus"
            style="@style/Typography.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/emerald_500"
            android:text="★ 4.0+"
            android:textColor="@color/white"
            android:textSize="12.5sp" />

        <RadioButton
            android:id="@+id/rbRating45Plus"
            style="@style/Typography.BodyMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:buttonTint="@color/emerald_500"
            android:text="★ 4.5+"
            android:textColor="@color/white"
            android:textSize="12.5sp" />
    </RadioGroup>

    <!-- OPEN NOW SWITCH ROW -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">

        <TextView
            style="@style/Typography.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="Open Now Only"
            android:textColor="@color/white"
            android:textSize="14sp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switchOpenNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            app:thumbTint="@color/emerald_400"
            app:trackTint="@color/emerald_800" />
    </RelativeLayout>

    <!-- ACTION BUTTONS ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnResetFilters"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_glass_panel"
            android:gravity="center"
            android:text="Reset"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnApplyFilters"
            style="@style/Typography.Button"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/bg_emerald_badge"
            android:gravity="center"
            android:text="Apply Filters"
            android:textColor="@color/emerald_400"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
