<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen_gradient">

    <!-- SUBTLE EMERALD GRID PATTERN -->
    <com.example.nearby.designsystem.GridBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="@dimen/space_24"
        android:paddingVertical="@dimen/space_32">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <!-- APP BRANDING HEADER -->
            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="App Logo"
                android:src="@drawable/ic_app_logo" />

            <TextView
                style="@style/Typography.HeadlineLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_12"
                android:text="Join Tourism Guide"
                android:textColor="@color/text_primary" />

            <TextView
                style="@style/Typography.BodyMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="Create your personal travel account in 3 quick steps"
                android:textColor="@color/text_secondary" />

            <!-- 3-STEP VISUAL PROGRESS INDICATOR -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_20"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/step_indicator_1"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_button_primary" />

                <View
                    android:layout_width="@dimen/space_8"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/step_indicator_2"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#27272A" />

                <View
                    android:layout_width="@dimen/space_8"
                    android:layout_height="1dp" />

                <View
                    android:id="@+id/step_indicator_3"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_weight="1"
                    android:background="#27272A" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_step_header"
                style="@style/Typography.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_8"
                android:text="STEP 1 OF 3: BASIC INFORMATION"
                android:textColor="@color/emerald_500" />

            <!-- STEP 1 CONTAINER: BASIC INFO -->
            <LinearLayout
                android:id="@+id/container_step_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical">

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:text="FULL NAME"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="User Icon"
                        android:src="@drawable/ic_profile" />

                    <EditText
                        android:id="@+id/et_reg_name"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Alex Rivera"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="EMAIL ADDRESS"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Email Icon"
                        android:src="@drawable/ic_profile" />

                    <EditText
                        android:id="@+id/et_reg_email"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="alex.rivera@example.com"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEP 2 CONTAINER: SECURITY -->
            <LinearLayout
                android:id="@+id/container_step_2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:text="CREATE PASSWORD"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Lock Icon"
                        android:src="@drawable/ic_check" />

                    <EditText
                        android:id="@+id/et_reg_password"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="At least 6 characters"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />

                    <ImageButton
                        android:id="@+id/btn_toggle_reg_password"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Toggle Password Visibility"
                        android:src="@drawable/ic_eye_off" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_reg_password_strength"
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="4dp"
                    android:text="Password Strength: None"
                    android:textColor="@color/emerald_500" />

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="CONFIRM PASSWORD"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Lock Confirm Icon"
                        android:src="@drawable/ic_check" />

                    <EditText
                        android:id="@+id/et_reg_confirm_password"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Re-enter your password"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />
                </LinearLayout>
            </LinearLayout>

            <!-- STEP 3 CONTAINER: PROFILE & OVERALL ACCOUNT SUMMARY -->
            <LinearLayout
                android:id="@+id/container_step_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- SUMMARY GLASS CARD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_panel"
                    android:orientation="vertical"
                    android:padding="@dimen/space_16">

                    <TextView
                        style="@style/Typography.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:text="ACCOUNT SUMMARY REVIEW"
                        android:textColor="@color/emerald_500" />

                    <TextView
                        android:id="@+id/tv_summary_name"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:text="Name: Alex Rivera"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tv_summary_email"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Email: alex.rivera@example.com"
                        android:textColor="@color/text_secondary" />

                    <TextView
                        android:id="@+id/tv_summary_password_status"
                        style="@style/Typography.BodySmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Password: •••••••• (Protected)"
                        android:textColor="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="PHONE NUMBER (OPTIONAL)"
                    android:textColor="@color/text_secondary" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/space_16">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Phone Icon"
                        android:src="@drawable/ic_profile" />

                    <EditText
                        android:id="@+id/et_reg_phone"
                        style="@style/Typography.BodyMedium"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="@dimen/space_12"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="+1 800-555-0199"
                        android:inputType="phone"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_secondary" />
                </LinearLayout>

                <TextView
                    style="@style/Typography.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="start"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="COUNTRY / REGION"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_reg_country"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_glass_panel"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/space_16"
                    android:text="🇺🇸 United States (+1)"
                    android:textColor="@color/text_primary" />

                <CheckBox
                    android:id="@+id/cb_agree_terms"
                    style="@style/Typography.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:checked="true"
                    android:text="I agree to the Terms of Service &amp; Privacy Policy"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <!-- ERROR TEXT -->
            <TextView
                android:id="@+id/tv_reg_error"
                style="@style/Typography.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_8"
                android:textColor="@color/status_danger"
                android:visibility="gone" />

            <!-- ACTION BUTTONS ROW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_reg_prev"
                    style="@style/Typography.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="@dimen/space_8"
                    android:layout_weight="1"
                    android:background="@drawable/bg_neutral_pill"
                    android:text="← Back"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/btn_reg_next"
                    style="@style/Typography.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="2"
                    android:background="@drawable/bg_button_primary"
                    android:text="Continue  →"
                    android:textColor="@color/white" />
            </LinearLayout>

            <!-- LOGIN LINK -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_24"
                android:orientation="horizontal">

                <TextView
                    style="@style/Typography.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account?"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tv_link_login"
                    style="@style/Typography.BodyMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_6"
                    android:text="Sign In"
                    android:textColor="@color/emerald_500" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
