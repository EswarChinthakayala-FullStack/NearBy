# =============================================================================
# Local Tourism Guide Backend - Categorized Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
PROJECT_NAME="Nearby Tourist Guide API"
ENVIRONMENT="development"  # Options: development, testing, staging, production
DEBUG=true
API_V1_STR="/api/v1"

# -----------------------------------------------------------------------------
# Database Credentials (MySQL 8)
# -----------------------------------------------------------------------------
MYSQL_SERVER="127.0.0.1"
MYSQL_PORT=3306
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_DB="nearby_db"

# -----------------------------------------------------------------------------
# JWT Authentication & Security
# -----------------------------------------------------------------------------
SECRET_KEY="change_this_to_a_secure_random_secret_key_in_production_environment"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# Redis & Celery Task Broker Config
# -----------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/1"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/2"

# -----------------------------------------------------------------------------
# Media Storage Settings
# -----------------------------------------------------------------------------
MEDIA_UPLOAD_DIR="app/media"
MAX_UPLOAD_SIZE_BYTES=10485760  # 10 MB limit

# -----------------------------------------------------------------------------
# External Third-Party APIs
# -----------------------------------------------------------------------------
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
WIKIPEDIA_API_URL="https://en.wikipedia.org/api/rest_v1"
WIKIMEDIA_COMMONS_API_URL="https://commons.wikimedia.org/w/api.php"
OSRM_ROUTING_URL="http://router.project-osrm.org"
BING_IMAGE_SEARCH_URL="https://www.bing.com/images/search"
EXTERNAL_REQUEST_TIMEOUT_SECONDS=15.0

# -----------------------------------------------------------------------------
# CORS & Security Settings
# -----------------------------------------------------------------------------
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:8000", "http://127.0.0.1:8000"]'

# -----------------------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO"
